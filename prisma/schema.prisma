generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id           String   @id @default(uuid())

  logo         String?
  name         String
  description  String?  @db.VarChar(150)

  email        String?
  phone        String?
  whatsapp     String?

  street       String
  number       String
  neighborhood String
  city         String
  state        String
  zipCode      String

  instagram    String?
  facebook     String?
  linkedin     String?
  youtube      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}